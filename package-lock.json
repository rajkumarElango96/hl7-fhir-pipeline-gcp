{
  "name": "pipeline",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "pipeline",
      "workspaces": [
        "lib/*",
        "services/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "lib/config": {
      "name": "@pipeline/config",
      "version": "0.1.0"
    },
    "lib/hl7": {
      "name": "@pipeline/hl7",
      "version": "0.1.0"
    },
    "node_modules/@faker-js/faker": {
      "version": "9.9.0",
      "resolved": "https://registry.npmjs.org/@faker-js/faker/-/faker-9.9.0.tgz",
      "integrity": "sha512-OEl393iCOoo/z8bMezRlJu+GlRGlsKbUAN7jKB6LhnKoqKve5DXRpalbItIIcwnCjs1k/FOPjFzcA6Qn+H+YbA==",
      "funding": [
        {
          "type": "opencollective",
          "url": "https://opencollective.com/fakerjs"
        }
      ],
      "license": "MIT",
      "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
      }
    },
    "node_modules/@pipeline/config": {
      "resolved": "lib/config",
      "link": true
    },
    "node_modules/@pipeline/ehr-simulator": {
      "resolved": "services/ehr-simulator",
      "link": true
    },
    "node_modules/@pipeline/fhir-transformer": {
      "resolved": "services/fhir-transformer",
      "link": true
    },
    "node_modules/@pipeline/hl7": {
      "resolved": "lib/hl7",
      "link": true
    },
    "node_modules/@pipeline/loader": {
      "resolved": "services/loader",
      "link": true
    },
    "node_modules/@pipeline/validator": {
      "resolved": "services/validator",
      "link": true
    },
    "services/ehr-simulator": {
      "name": "@pipeline/ehr-simulator",
      "version": "0.1.0",
      "dependencies": {
        "@faker-js/faker": "^9.9.0",
        "@pipeline/hl7": "*"
      }
    },
    "services/fhir-transformer": {
      "name": "@pipeline/fhir-transformer",
      "version": "0.1.0",
      "dependencies": {
        "@pipeline/config": "*",
        "@pipeline/hl7": "*"
      }
    },
    "services/loader": {
      "name": "@pipeline/loader",
      "version": "0.1.0",
      "dependencies": {
        "@pipeline/config": "*",
        "@pipeline/hl7": "*"
      }
    },
    "services/validator": {
      "name": "@pipeline/validator",
      "version": "0.1.0",
      "dependencies": {
        "@pipeline/config": "*",
        "@pipeline/hl7": "*"
      }
    }
  }
}
