{
  "name": "pipeline",
  "private": true,
  "type": "module",
  "description": "HL7v2 ADT -> FHIR R4 integration engine on Kafka (portfolio project, synthetic data only)",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test packages/*/test/*.test.js",
    "infra:kafka": "kafka-server-start /opt/homebrew/etc/kafka/server.properties",
    "infra:fhir": "cd .local/hapi-fhir-jpaserver-starter && java -jar target/ROOT.war",
    "topics": "node scripts/create-topics.js",
    "dev": "node scripts/dev.js",
    "simulate": "node services/hl7-simulator/index.js",
    "check": "node scripts/check-fhir.js"
  },
  "allowScripts": {
    "@confluentinc/kafka-javascript@1.11.0": true
  }
}
