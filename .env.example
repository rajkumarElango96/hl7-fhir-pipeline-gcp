# Copy to .env for local runs. On GCP these are set on the Cloud Run jobs by infra/deploy.sh.
GCP_PROJECT=hl7-fhir-pipeline
GCP_REGION=asia-south1
LANDING_BUCKET=replace-with-your-landing-bucket

HEALTHCARE_DATASET=hl7-fhir-pipeline-landing-fhir
FHIR_STORE=replace-with-your-fhir-store-id

# Optional overrides (defaults shown)
# BQ_RAW_DATASET=raw
# BQ_QUALITY_DATASET=quality
# RAW_TABLE=adt_messages
# VALIDATED_TABLE=adt_validated
# REJECTED_TABLE=adt_rejected
# FHIR_RESULTS_TABLE=fhir_results
# HL7_TZ_OFFSET=+05:30

# Set per run by the workflow; set it yourself to run a job locally, e.g.
# INPUT_FILE=hospital=SYNH-CHN/date=2026-10-24/SYNH-CHN_20261024T000000.hl7
